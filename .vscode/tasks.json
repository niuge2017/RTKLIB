{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RTKLIB",
            "type": "shell",
            "command": "make",
            "args": ["-f", "${workspaceFolder}/app/str2str/gcc/Makefile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "options": {
                "cwd": "${workspaceFolder}/app/str2str/gcc"
            }
        }
    ]
}